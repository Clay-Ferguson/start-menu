# Template only. build-deb-install.sh rewrites Exec= and Icon= for where it is
# installing to, so the paths below are never used.
[Desktop Entry]
Name=Start Menu
Comment=Launch scripts via an arrow-key menu
Exec=/path/to/start-menu/start.sh
Icon=/path/to/start-menu/start-menu.png
Terminal=false
Type=Application
Categories=Utility;
StartupWMClass=start-menu
