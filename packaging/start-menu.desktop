# Template only. packaging/build-deb.sh rewrites Exec= and Icon= for where it is
# installing to, so the path below is never used.
[Desktop Entry]
Name=Start Menu
Comment=Launch scripts via an arrow-key menu
Exec=/path/to/start-menu/start.sh
Icon=start-menu
Terminal=false
Type=Application
Categories=Utility;
StartupWMClass=start-menu
